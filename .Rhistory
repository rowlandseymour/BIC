#define potential V and unnormalised density
V <- function(x){
abs(x)^3
}
exp_V <- function(x){
exp(-V(x))
}
#calculate normalisation constant
C <- integrate(exp_V,-Inf,Inf)$value
#normalised density
pi <- function(x){
exp(-V(x))/C
}
nabla_V <- function(x){
sign(x)*3*x^2
}
