set.seed(123)
n_samples <- 10000                 # number of repetitions
sample_sizes <- c(1, 2, 5, 10, 30, 50, 100)
# Create a grid of plots
par(mfrow = c(3, 3), mar = c(3, 3, 2, 1))
for (n in sample_sizes) {
# Generate n_samples averages of n exponential(1) random variables
samples <- matrix(rexp(n_samples * n, rate = 1), ncol = n)
sample_means <- rowMeans(samples)
# Standardize (subtract mean and divide by sd/sqrt(n))
standardized <- (sample_means - 1) / (1 / sqrt(n))
# Plot histogram
hist(standardized, breaks = 40, freq = FALSE,
col = "skyblue", border = "white",
main = paste("n =", n),
xlab = "Standardized sample mean", ylab = "Density")
# Overlay standard normal density
curve(dnorm(x, mean = 0, sd = 1), add = TRUE, col = "red", lwd = 2)
}
mtext("Central Limit Theorem: Exponential(1) → Normal(0,1)", outer = TRUE, line = -2, cex = 1.2)
