:::{.definition}
# Set seed for reproducibility
set.seed(42)
# Observed data
y <- c(2, 3, 1, 4)  # y_1, y_2, y_3, y_4
n <- 1000
# Log unnormalized target density
log_pi <- function(p) {
if (p <= 0 || p >= 1) return(-Inf)
# First part: product over y_1 to y_4
log_prod <- sum(lchoose(n, y) + y * log(p) + (n - y) * log(1 - p))
# Second part: sum over y_5 from 0 to 5
y5 <- 0:5
log_terms <- lchoose(n, y5) + y5 * log(p) + (n - y5) * log(1 - p)
log_sum <- log(sum(exp(log_terms - max(log_terms)))) + max(log_terms)  # Log-sum-exp trick
return(log_prod + log_sum)
}
# Metropolis-Hastings algorithm
N <- 10000  # Number of iterations
p_chain <- numeric(N)
p_chain[1] <- 0.5  # Initial value
delta <- 0.05  # Proposal width
for (t in 2:N) {
p_current <- p_chain[t-1]
# Propose new p from uniform distribution, constrained to [0, 1]
p_proposed <- runif(1, max(0, p_current - delta), min(1, p_current + delta))
# Compute acceptance ratio in log-space
log_alpha <- log_pi(p_proposed) - log_pi(p_current)
alpha <- min(1, exp(log_alpha))
# Accept or reject
if (runif(1) < alpha) {
p_chain[t] <- p_proposed
} else {
p_chain[t] <- p_current
}
}
# Discard burn-in and summarize
burn_in <- 1000
p_samples <- p_chain[(burn_in + 1):N]
cat("Mean of p:", mean(p_samples), "\n")
cat("Std of p:", sd(p_samples), "\n")
# Optional: Plot the chain and histogram
par(mfrow = c(1, 2))
plot(p_chain, type = "l", main = "Trace Plot of p", xlab = "Iteration", ylab = "p")
hist(p_samples, breaks = 50, main = "Posterior of p", xlab = "p", freq = FALSE)
set.seed(42)
y <- c(2, 3, 1, 4)  # Observed data
n <- 1000
N <- 10000
p_chain <- numeric(N)
y5_chain <- numeric(N)
p_chain[1] <- 0.5
y5_chain[1] <- 2  # Initial guess for y_5
for (t in 2:N) {
# Sample p | y_1, y_2, y_3, y_4, y_5
y_sum <- sum(y) + y5_chain[t-1]
p_chain[t] <- rbeta(1, y_sum + 1, 5 * n - y_sum + 1)
# Sample y_5 | p (truncated binomial)
p <- p_chain[t]
y5_probs <- dbinom(0:5, n, p)  # Unnormalized probabilities
y5_probs <- y5_probs / sum(y5_probs)  # Normalize
y5_chain[t] <- sample(0:5, 1, prob = y5_probs)
}
# Summarize
burn_in <- 1000
p_samples <- p_chain[(burn_in + 1):N]
y5_samples <- y5_chain[(burn_in + 1):N]
cat("Mean of p:", mean(p_samples), "\n")
cat("Mean of y_5:", mean(y5_samples), "\n")
hist(p_samples)
plot(p_samples, type = "l", main = "Trace Plot of p", xlab = "Iteration", ylab = "p")
plot(p_chain, type = "l", main = "Trace Plot of p", xlab = "Iteration", ylab = "p")
hist(p_samples, breaks = 50, main = "Posterior of p", xlab = "p", freq = FALSE)
