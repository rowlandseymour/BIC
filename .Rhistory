## Bernoulli LLN + CLT side-by-side
set.seed(123)
# Parameters
p <- 0.3
N_path <- 1500        # length of one LLN path
n_samples <- 20000    # number of repetitions for CLT
n_values <- c(5, 20, 100)  # sample sizes for CLT panel
par(mfrow = c(1, 2), mar = c(4, 4, 3, 1))
##### (Left) LLN: running sample mean converges to p #####
x <- rbinom(N_path, size = 1, prob = p)
run_mean <- cumsum(x) / seq_along(x)
plot(run_mean, type = "l", lwd = 2,
ylim = c(0, 1),
xlab = "n",
ylab = "Running sample mean",
main = "LLN: Bernoulli(p) running mean")
abline(h = p, col = "red", lwd = 2)
legend("bottomright",
legend = c("Running mean", sprintf("True p = %.2f", p)),
lwd = c(2, 2), col = c("black", "red"), bty = "n")
##### (Right) CLT: standardized sample means approach N(0,1) #####
# For each n in n_values, simulate sample means and standardize
std_means_list <- lapply(n_values, function(n) {
samp <- matrix(rbinom(n_samples * n, size = 1, prob = p), ncol = n)
means <- rowMeans(samp)
(means - p) / sqrt(p * (1 - p) / n)   # Z = (Xbar - p) / sqrt(var / n)
})
# Determine a common x-range for densities
dens_list <- lapply(std_means_list, density, adjust = 1)
x_min <- min(sapply(dens_list, function(d) min(d$x)), -4)
x_max <- max(sapply(dens_list, function(d) max(d$x)),  4)
plot(0, 0, type = "n",
xlim = c(x_min, x_max), ylim = c(0, 0.9),
xlab = "Standardized sample mean",
ylab = "Density",
main = "CLT: Bernoulli(p) standardized means")
cols <- c("steelblue", "orange3", "darkgreen")
lwds <- c(2, 2, 2)
for (i in seq_along(n_values)) {
lines(dens_list[[i]]$x, dens_list[[i]]$y, lwd = lwds[i], col = cols[i])
}
# Overlay N(0,1) density
curve(dnorm(x), add = TRUE, lwd = 2, lty = 2)
legend("topleft",
legend = c(paste0("n = ", n_values), "N(0,1)"),
col = c(cols, "black"),
lwd = c(lwds, 2),
lty = c(rep(1, length(n_values)), 2),
bty = "n")
##### (Left) LLN: running sample mean converges to p #####
x <- rbinom(N_path, size = 1, prob = p)
run_mean <- cumsum(x) / seq_along(x)
run_clt <- sqrt(n_seq) * (run_mean - p) / sqrt(p * (1 - p))
x <- rbinom(N_path, size = 1, prob = p)
n_seq <- seq_along(x)
cum_sum <- cumsum(x)
run_mean <- cumsum(x) / seq_along(x)
run_clt <- sqrt(n_seq) * (run_mean - p) / sqrt(p * (1 - p))
x
n_seq
run_clt
plot(run_clt, type = "l", lwd = 2,
ylim = c(0, 1),
xlab = "n",
ylab = "Running sample mean",
main = "LLN: Bernoulli(p) running mean")
p
